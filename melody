-- Copy Link logic
copyBtn.MouseButton1Click:Connect(function()
	local copy = setclipboard or toclipboard or (syn and syn.write_clipboard)
	if copy then
		copy(CONFIG.KeyLink)
		setStatus("link copied! ♡", GREEN)
		for _ = 1, 5 do spawnHeart(true) end
	else
		inputBox.Text = CONFIG.KeyLink
		setStatus("no clipboard support, link is in the box ✿", PINK_DARK)
	end
end)

-- Check Key logic
local checking = false
checkBtn.MouseButton1Click:Connect(function()
	if checking then return end
	local key = inputBox.Text:gsub("%s+", "")
	if key == "" then
		setStatus("please enter a key first ✿", PINK_DARK)
		return
	end

	checking = true
	setStatus("checking your key... ♡", Color3.fromRGB(205, 140, 170))
	task.wait(0.4)

	local ok, valid = pcall(validateKey, key)
	if ok and valid then
		setStatus("yay! key accepted ♡", GREEN)
		tween(inputStroke, {Color = GREEN})
		for _ = 1, 16 do
			spawnHeart(true)
			task.wait(0.03)
		end
		task.wait(0.6)
		gui:Destroy()
		onSuccess()
	else
		setStatus("oops, invalid key. try again ♡", RED)
		tween(inputStroke, {Color = RED})
		local origin = inputBox.Position
		for _ = 1, 3 do
			tween(inputBox, {Position = origin + UDim2.new(0, 6, 0, 0)}, 0.05)
			task.wait(0.05)
			tween(inputBox, {Position = origin - UDim2.new(0, 6, 0, 0)}, 0.05)
			task.wait(0.05)
		end
		tween(inputBox, {Position = origin}, 0.05)
		task.wait(0.8)
		tween(inputStroke, {Color = PINK_SOFT})
	end
	checking = false
end)

