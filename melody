-- Button factory
local function makeButton(text, position, color, textColor, outline)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(0.5, -26, 0, 44)
	b.Position = position
	b.BackgroundColor3 = color
	b.Text = text
	b.TextColor3 = textColor
	b.Font = Enum.Font.FredokaOne
	b.TextSize = 17
	b.AutoButtonColor = false
	b.Parent = main
	round(b, 22)
	if outline then stroke(b, outline, 2.5) end

	local hover = color:Lerp(WHITE, 0.25)
	b.MouseEnter:Connect(function() tween(b, {BackgroundColor3 = hover}) end)
	b.MouseLeave:Connect(function() tween(b, {BackgroundColor3 = color}) end)
	b.MouseButton1Down:Connect(function() tween(b, {Size = UDim2.new(0.5, -30, 0, 40)}, 0.08) end)
	b.MouseButton1Up:Connect(function() tween(b, {Size = UDim2.new(0.5, -26, 0, 44)}, 0.08) end)
	return b
end

