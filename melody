local symbols = {"♥", "♡", "✿", "★"}
local palette = {PINK_HOT, PINK_BAND, PINK_SOFT, Color3.fromRGB(255, 140, 185)}

local function spawnHeart(burst)
	local h = Instance.new("TextLabel")
	h.BackgroundTransparency = 1
	h.Text = symbols[math.random(1, #symbols)]
	h.TextColor3 = palette[math.random(1, #palette)]
	h.TextSize = math.random(12, 22)
	h.Font = Enum.Font.GothamBold
	h.Size = UDim2.new(0, 20, 0, 20)
	h.TextTransparency = 0.3
	h.Parent = hearts

	if burst then
		h.Position = UDim2.new(0.5, -10, 0.5, -10)
		local goal = UDim2.new(math.random(), -10, math.random(), -10)
		TweenService:Create(h, TweenInfo.new(1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{Position = goal, TextTransparency = 1}):Play()
		task.delay(1, function() h:Destroy() end)
	else
		h.Position = UDim2.new(math.random(), -10, 1, 4)
		local t = math.random(30, 50) / 10
		TweenService:Create(h, TweenInfo.new(t, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
			{Position = UDim2.new(h.Position.X.Scale, -10, -0.1, 0), TextTransparency = 1}):Play()
		task.delay(t, function() h:Destroy() end)
	end
end

